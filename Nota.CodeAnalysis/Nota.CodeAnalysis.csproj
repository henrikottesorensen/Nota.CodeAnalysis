<Project Sdk="Microsoft.NET.Sdk" ToolsVersion="Current">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/Notalib/Nota.CodeAnalysis</RepositoryUrl>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <PackageReadmeFile>content/README.md</PackageReadmeFile>
  </PropertyGroup>

  <!--
    None of these carry PrivateAssets, and none of them may. This package exists to hand its rules
    on: PrivateAssets stops a reference flowing to consumers, which for an analyser means the rules
    never arrive. The globalconfig would still set their severities, and nothing would ever report -
    the same silent failure as a rule that does not exist.

    Rider adds PrivateAssets automatically when it upgrades an analyser reference. That is right for
    an ordinary project and wrong here; it happened once already and cost VSTHRD100, which this
    package declares an error and consumers were not receiving at all.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="18.7.23" />
    <PackageReference Include="SerilogAnalyzer" Version="0.15.0" />
    <PackageReference Include="StyleCop.Analyzers.Unstable" Version="1.2.0.556" />
    <PackageReference Include="UsingLayoutAnalyser" Version="0.4.0" />

    <!-- Sets Version from the nearest git tag (Directory.Build.props declares the "v" prefix) plus a
         height above it, so the package version can never drift from what was actually tagged. Build-
         time only: PrivateAssets stops it flowing to consumers, who have no reason to inherit it. -->
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!--
    Nota's own analysers (NOTA0003) and their code fixes, carried in this package rather than as a
    dependency. ReferenceOutputAssembly="false" because nothing here calls them - the reference only
    makes them build first - and PrivateAssets so that pack does not turn them into package
    dependencies that do not exist on any feed. NotaPackAnalysers puts the built assemblies where a
    consumer's compiler looks for analysers.
  -->
  <ItemGroup>
    <ProjectReference Include="../Nota.CodeAnalysis.Analysers/Nota.CodeAnalysis.Analysers.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Nota.CodeAnalysis.Analysers.CodeFixes/Nota.CodeAnalysis.Analysers.CodeFixes.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);NotaPackAnalysers</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="NotaPackAnalysers">
    <MSBuild Projects="@(ProjectReference)" Targets="GetTargetPath">
      <Output TaskParameter="TargetOutputs" ItemName="NotaAnalyserAssembly" />
    </MSBuild>

    <ItemGroup>
      <TfmSpecificPackageFile Include="@(NotaAnalyserAssembly)" PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <None Include="build/Nota.CodeAnalysis.props" Pack="true" PackagePath="/build" />
    <None Include="build/Nota.CodeAnalysis.targets" Pack="true" PackagePath="/build" />
    <None Include="content/Nota.CodeAnalysis.globalconfig" Pack="true" PackagePath="/content" />
    <None Include="../README.md" Pack="true" PackagePath="/content" />
  </ItemGroup>
</Project>
